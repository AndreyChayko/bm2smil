{
  "name": "bm2smil-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Mini UI (Vite) to convert Lottie/Bodymovin JSON to animated SVG (SMIL) via bodymovin-to-smil (server runs separately)",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:ui",
    "dev:ui": "vite",
    "dev:server": "npm run --prefix ../server dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run --prefix ../server start"
  },
  "dependencies": {},
  "devDependencies": {
    "vite": "^5.4.8",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  }
}
